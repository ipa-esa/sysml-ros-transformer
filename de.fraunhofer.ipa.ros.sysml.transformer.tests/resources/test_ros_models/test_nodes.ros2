# ROS 2 node artifact definitions for the test fixture.
# These define the node interfaces referenced by the .rossystem file.

test_drivers:
  artifacts:
    camera_driver:
      node: camera_node
      publishers:
        image:
          type: sensor_msgs/msg/Image

test_perception:
  artifacts:
    object_detector:
      node: detector_node
      subscribers:
        image:
          type: sensor_msgs/msg/Image
      publishers:
        detections:
          type: vision_msgs/msg/Detection2DArray
