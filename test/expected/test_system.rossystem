# Expected output from the forward SysML-to-.rossystem transformer.
# Input: test/test_model/test_annotated.sysml
# This file is used for automated validation.

test_system:
  fromFile: "test_pkg/launch/test.launch.py"
  nodes:
    "camera":
      from: "test_drivers.camera_node"
      interfaces:
        - "camera_image": pub-> "camera_driver::image"
    "detector":
      from: "test_perception.detector_node"
      interfaces:
        - "detector_image": sub-> "object_detector::image"
        - "detector_detections": pub-> "object_detector::detections"
  connections:
    - ["camera_image", "detector_image"]
