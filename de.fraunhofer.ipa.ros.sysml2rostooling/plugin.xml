<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension
        point="org.eclipse.ui.handlers">
        <handler
              class="de.fraunhofer.ipa.ros.sysml2rostooling.GenerationHandler"
              commandId="de.fraunhofer.ipa.ros.sysml2rostooling.command">
        </handler>
    </extension>

    <extension
         point="org.eclipse.ui.commands">
      <command
            id="de.fraunhofer.ipa.ros.sysml2rostooling.command"
            name="Generate .rossystem from SysML">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            allPopups="false"
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <command
                commandId="de.fraunhofer.ipa.ros.sysml2rostooling.command">
             <visibleWhen
                   checkEnabled="false">
                <iterate
                      ifEmpty="false">
                   <adapt
                         type="org.eclipse.core.resources.IFile">
                      <test
                            property="org.eclipse.core.resources.extension"
                            value="sysml">
                      </test>
                   </adapt>
                </iterate>
             </visibleWhen>
          </command>
       </menuContribution>
    </extension>

</plugin>
